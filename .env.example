# Copy this file to .env for local development and fill in real values.
# NEVER commit the actual .env file — it's already covered by .gitignore.
#
# This file documents every secret the project needs. Where each value
# actually lives depends on where that code runs — see notes below.

# --- Database (backend, jobs) ---
# Local dev: paste your Supabase connection string here.
# Deployed: set in Render's environment variable dashboard (backend) and
# in GitHub Actions repo secrets (for the scheduled jobs).
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Steam Web API (backend, jobs) ---
# Get a free key at https://steamcommunity.com/dev
# Same "set it in every place that runs code" rule as DATABASE_URL above.
STEAM_API_KEY=your_steam_web_api_key_here

# --- IsThereAnyDeal (jobs/backfill_launch_prices.py only) ---
# Free key from https://isthereanydeal.com/apps/dev — no billing.
# Only jobs/backfill_launch_prices.py reads it; the API runs without it.
ITAD_API_KEY=your_itad_api_key_here

# --- Anthropic API (backend LLM reasoning layer, jobs) ---
# This is separate from your Claude subscription / Claude Code — it's a
# metered API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Frontend (Next.js) ---
# Public env vars need the NEXT_PUBLIC_ prefix to be readable in the
# browser — don't put secrets here, only things safe to expose client-side.
# Set the real values in Vercel's project settings, not just locally.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
